{
	"name": "migoto",
	"displayName": "3DMigoto",
	"description": "Extension for working with .ini and .hlsl files used by 3DMigoto.",
	"author": {
		"name": "LupoMikti",
		"url": "https://github.com/lupomikti"
	},
	"contributors": [
		{
			"name": "SinsOfSeven@sinsofseven",
			"url": "https://github.com/SinsOfSeven"
		},
		{
			"name": "!someone name has 63B long?",
			"url": "https://github.com/lewis252310"
		},
		{
			"name": "AGMG",
			"url": "https://discord.gg/AGMG"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/lupomikti/migoto-vscode.git"
	},
	"publisher": "AGMG",
	"version": "0.11.1",
	"pricing": "Free",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "migoto",
				"aliases": [
					"Migoto",
					"3dm-ini",
					"3dmigoto"
				],
				"extensions": [
					".ini",
					".3dm",
					".migoto"
				],
				"configuration": "./migoto.language-configuration.json"
			},
			{
				"id": "migoto-hlsl",
				"aliases": [
					"Migoto HLSL"
				],
				"extensions": [
					".hlsl"
				]
			}
		],
		"grammars": [
			{
				"language": "migoto-hlsl",
				"scopeName": "source.migoto.hlsl",
				"path": "./syntaxes/migoto-hlsl.tmLanguage.json"
			},
			{
				"language": "migoto",
				"scopeName": "source.migoto",
				"path": "./syntaxes/migoto.tmLanguage.json"
			},
			{
				"path": "./syntaxes/regexp.tmLanguage.json",
				"scopeName": "source.regexp.pcre2"
			},
			{
				"path": "./syntaxes/regexp-replace.tmLanguage.json",
				"scopeName": "source.regexp-replace.pcre2"
			}
		],
		"snippets": [
			{
				"language": "migoto",
				"path": "./snippets/migoto.snippets.json"
			}
		]
	}
}
