{
	"comments": {
		"lineComment": ";"
	},
	"brackets": [
		[
			"{",
			"}"
		],
		[
			"[",
			"]"
		],
		[
			"(",
			")"
		]
	],
	"autoClosingPairs": [
		[
			";<",
			";>"
		],
		[
			"{",
			"}"
		],
		[
			"[",
			"]"
		],
		[
			"(",
			")"
		],
		{
			"open": "\"",
			"close": "\"",
			"notIn": [
				"string"
			]
		},
		{
			"open": "'",
			"close": "'",
			"notIn": [
				"string",
				"comment"
			]
		}
	],
	"surroundingPairs": [
		[
			"{",
			"}"
		],
		[
			"[",
			"]"
		],
		[
			"(",
			")"
		],
		[
			"\"",
			"\""
		],
		[
			"'",
			"'"
		]
	],
	"folding": {
		"markers": {
			"start": "^\\s*;<",
			"end": "^\\s*;.*>"
		}
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*;<.*",
			"afterText": ";>$",
			"action": {
				"indent": "indentOutdent",
				"appendText": ";; "
			}
		},
		{
			"beforeText": "^\\s*;;.*(?<!>$)$",
			"action": {
				"indent": "none",
				"appendText": ";; "
			}
		}
	],
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(?:(?:else |el)?if|else).*?\\s*$",
		"decreaseIndentPattern": "^\\s*(?:(?:else |el)if|else|endif).*?\\s*$"
	}
}
